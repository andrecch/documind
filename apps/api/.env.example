# DocuMind API — copia este archivo a .env (apps/api/.env o la raíz del repo; ambos se leen).
# La API también puede recibir las variables directamente del entorno del shell.

# PostgreSQL 16 + pgvector del docker-compose (puerto host 5433)
DATABASE_URL=postgres://documind:documind@localhost:5433/documind

# Puerto de la API (la web hace proxy /api/* → http://localhost:4000/api/v1)
PORT=4000

# Clave de OpenRouter para el modo real (OCR visión + embeddings).
# Con DOCUMIND_FAKE_PROVIDERS=1 no se necesita ni se usa.
OPENROUTER_API_KEY=

# 1 = providers fake (SAMPLE_EXTRACTION + embeddings determinísticos).
# No gasta cuota; es el modo de los tests de API y del e2e de web.
DOCUMIND_FAKE_PROVIDERS=1

# Carpeta de almacenamiento de archivos subidos, relativa al cwd del proceso.
# Con pnpm --filter @documind/api (dev, test, start) el cwd es apps/api → apps/api/uploads.
# Los archivos son datos de runtime: la carpeta está fuera de git.
UPLOAD_DIR=uploads
